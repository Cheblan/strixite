{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "strix",
      "displayName": "Strix Halo (gfx1151), Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/strix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "strix-debug",
      "displayName": "Strix Halo (gfx1151), RelWithDebInfo",
      "inherits": "strix",
      "binaryDir": "${sourceDir}/build/strix-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "strix-roctx",
      "inherits": "strix",
      "displayName": "strix + ROCTX ranges (profiling only)",
      "binaryDir": "${sourceDir}/build/strix-roctx",
      "cacheVariables": {
        "STRIX_ROCTX": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "strix",
      "configurePreset": "strix"
    },
    {
      "name": "strix-debug",
      "configurePreset": "strix-debug"
    },
    {
      "name": "strix-roctx",
      "configurePreset": "strix-roctx"
    }
  ]
}
